package academic;

import java.awt.BorderLayout;
import java.awt.Color;
import java.awt.Dimension;
import java.awt.Font;
import java.awt.GridBagConstraints;
import java.awt.GridBagLayout;
import java.awt.Insets;
import javax.swing.BorderFactory;
import javax.swing.JButton;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JPanel;
import javax.swing.SwingConstants;

/**
 * Colores y fuentes compartidos por las dos pantallas.
 */
final class Estilo {

    static final Color AZUL_OSCURO = new Color(0x1F3A5F);
    static final Color AZUL = new Color(0x2E6FBA);
    static final Color AZUL_CLARO = new Color(0xE8F0FB);
    static final Color MENU_FONDO = new Color(0x26344B);
    static final Color MENU_ACTIVO = new Color(0x2E6FBA);
    static final Color FONDO = new Color(0xF4F6FA);
    static final Color BORDE = new Color(0xD5DBE5);
    static final Color FILA_PAR = Color.WHITE;
    static final Color FILA_IMPAR = new Color(0xF0F4FA);
    static final Color TEXTO = new Color(0x1E2633);
    static final Color TEXTO_SUAVE = new Color(0x667085);
    static final Color ERROR = new Color(0xC0392B);
    static final Color OK = new Color(0x1E8449);

    static final Font FUENTE = new Font("Segoe UI", Font.PLAIN, 14);
    static final Font FUENTE_NEGRITA = new Font("Segoe UI", Font.BOLD, 14);
    static final Font TITULO = new Font("Segoe UI", Font.BOLD, 24);
    static final Font SUBTITULO = new Font("Segoe UI", Font.PLAIN, 14);

    private Estilo() {
    }

    static void boton(JButton b, Color fondo, Color texto) {
        b.setFont(FUENTE_NEGRITA);
        b.setBackground(fondo);
        b.setForeground(texto);
        b.setFocusPainted(false);
        b.setBorderPainted(false);
        b.setContentAreaFilled(false);
        b.setOpaque(true);
    }

    /** Encabezado de las pantallas (arriba). */
    static JPanel crearEncabezado(String detalleDerecha) {
        JPanel encabezado = new JPanel(new BorderLayout());
        encabezado.setBackground(AZUL_OSCURO);
        encabezado.setBorder(BorderFactory.createEmptyBorder(16, 24, 16, 24));
        encabezado.setPreferredSize(new Dimension(0, 72));

        JLabel titulo = new JLabel("Sistema Académico");
        titulo.setFont(TITULO);
        titulo.setForeground(Color.WHITE);

        JLabel detalle = new JLabel(detalleDerecha, SwingConstants.RIGHT);
        detalle.setFont(SUBTITULO);
        detalle.setForeground(new Color(0xC9D8EE));

        encabezado.add(titulo, BorderLayout.WEST);
        encabezado.add(detalle, BorderLayout.EAST);
        return encabezado;
    }

    /** Menú lateral (izquierda). "activa" es "Inicio" o "Estudiantes". */
    static JPanel crearMenu(JFrame actual, String activa) {
        JPanel menu = new JPanel(new GridBagLayout());
        menu.setBackground(MENU_FONDO);
        menu.setPreferredSize(new Dimension(230, 0));
        menu.setBorder(BorderFactory.createEmptyBorder(18, 12, 18, 12));

        GridBagConstraints c = new GridBagConstraints();
        c.gridx = 0;
        c.weightx = 1.0;
        c.fill = GridBagConstraints.HORIZONTAL;
        c.insets = new Insets(0, 0, 8, 0);

        JLabel seccion = new JLabel("MENÚ");
        seccion.setFont(FUENTE_NEGRITA);
        seccion.setForeground(new Color(0x8FA3C0));
        seccion.setBorder(BorderFactory.createEmptyBorder(0, 10, 6, 0));
        c.gridy = 0;
        menu.add(seccion, c);

        JButton inicio = botonMenu("Inicio", activa.equals("Inicio"));
        inicio.addActionListener(e -> {
            if (!activa.equals("Inicio")) {
                new Jf_Menu().setVisible(true);
                actual.dispose();
            }
        });
        c.gridy = 1;
        menu.add(inicio, c);

        JButton estudiantes = botonMenu("Estudiantes", activa.equals("Estudiantes"));
        estudiantes.addActionListener(e -> {
            if (!activa.equals("Estudiantes")) {
                new JF_Estudiante().setVisible(true);
                actual.dispose();
            }
        });
        c.gridy = 2;
        menu.add(estudiantes, c);

        // Relleno: empuja "Salir" hacia abajo
        c.gridy = 3;
        c.weighty = 1.0;
        c.fill = GridBagConstraints.BOTH;
        JPanel relleno = new JPanel();
        relleno.setOpaque(false);
        menu.add(relleno, c);

        JButton salir = botonMenu("Salir", false);
        salir.setBackground(new Color(0x8E3B46));
        salir.addActionListener(e -> System.exit(0));
        c.gridy = 4;
        c.weighty = 0;
        c.fill = GridBagConstraints.HORIZONTAL;
        c.insets = new Insets(0, 0, 0, 0);
        menu.add(salir, c);
        return menu;
    }

    private static JButton botonMenu(String texto, boolean activo) {
        JButton b = new JButton(texto);
        boton(b, activo ? MENU_ACTIVO : MENU_FONDO, Color.WHITE);
        b.setHorizontalAlignment(SwingConstants.LEFT);
        b.setBorder(BorderFactory.createEmptyBorder(11, 14, 11, 14));
        return b;
    }
}
